# ==============================================================================
# SCHOOL MANAGEMENT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT THE ACTUAL .env FILE CONTAINING PRODUCTION SECRETS.
# Copy this file to .env and configure values appropriate for your environment.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
# For local Docker Compose deployment:
DB_HOST=postgres
DB_PORT=5432
DB_NAME=school_management
DB_USER=school_admin
DB_PASSWORD=change_this_in_production_secure_pass_2026
DB_POOL_MAX=20
DB_TIMEOUT_MS=5000

# Full Database Connection URL (alternative to individual fields)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://school_admin:change_this_in_production_secure_pass_2026@postgres:5432/school_management

# In-Memory Mode Fallback (set to 'true' for zero-dependency standalone testing)
DB_IN_MEMORY=false

# Security & CORS
CORS_ORIGIN=*
TRUST_PROXY=true

# Reverse Proxy & SSL Configuration (used by Nginx and deployment scripts)
NGINX_PORT=80
NGINX_SSL_PORT=443
DOMAIN_NAME=localhost
SSL_CERT_PATH=/etc/nginx/certs/school-api.crt
SSL_KEY_PATH=/etc/nginx/certs/school-api.key

# Automated Backup Settings
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

